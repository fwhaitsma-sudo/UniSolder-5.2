<?xml version="1.0" encoding="utf-8"?>
<!-- A yellow "U" that bends into a temperature curve up to the dashed set-temperature line -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.0"
        android:scaleY="1.0"
        android:translateX="-2"
        android:translateY="1">
        <!-- set temperature -->
        <path
            android:pathData="M43.5,34 L45,34 M49.5,34 L51,34 M55.5,34 L57,34 M61.5,34 L63,34 M67.5,34 L69,34 M73.5,34 L75,34"
            android:strokeColor="#78909C"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <!-- the U that turns into the temperature curve -->
        <path
            android:pathData="M32,34 L32,58 A20,20 0 0 0 72,58 C72,44 74,38 78,34"
            android:strokeColor="#FFC107"
            android:strokeWidth="9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
